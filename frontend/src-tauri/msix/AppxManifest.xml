<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do pacote MSIX do Dito para a Microsoft Store.

  Identity e PublisherDisplayName vêm do Partner Center (Product management →
  Product identity) e precisam ser idênticos aos de lá, senão a Store recusa o
  envio. __VERSION__ é trocado pelo CI (.github/workflows/build-desktop.yml):
  a Store exige versão maior a cada envio, com o último campo zerado.

  runFullTrust é o que deixa um app de desktop comum (o Tauri) rodar dentro do
  pacote; o microfone precisa ser declarado para o Windows oferecer a permissão
  a um app empacotado. O áudio do sistema (loopback do WASAPI) não exige
  capacidade nenhuma.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <Identity
    Name="AlbieCloud.57831C11EA014"
    Publisher="CN=83C50F24-B6E7-4443-A4B7-95AFDF314BFA"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <!-- O ponto faz parte do nome reservado no Partner Center
         (Manage app names: "Dito."), a marca da própria landing — sem ele a
         Store recusa o pacote: "usa um nome de exibição que você não
         reservou". -->
    <DisplayName>Dito.</DisplayName>
    <PublisherDisplayName>Albie Cloud</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <Application Id="Dito" Executable="Dito.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Dito."
        Description="Transcreve e resume reuniões, aulas e áudios — e grava as duas vozes da chamada."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Dito" />
      </uap:VisualElements>

      <!--
        Iniciar com o Windows. Dentro de um pacote MSIX a chave `Run` do
        registro (o que o tauri-plugin-autostart escreve) não vale: o Windows
        só liga na inicialização o que está declarado aqui. Sem isto, na versão
        da Store o detector de reunião só existiria depois de a pessoa abrir o
        Dito na mão — justamente o contrário do recurso.

        Enabled="false" porque quem liga é o app, pelo interruptor de
        Configurações (StartupTask::RequestEnableAsync, ver src/inicio.rs). O
        TaskId é o mesmo nome usado lá e não pode mudar depois: é por ele que o
        Windows reconhece a tarefa já existente de uma versão anterior.

        Parameters passa ao executável o mesmo sinalizador de início escondido
        que o plugin passa fora do pacote (ARG_MINIMIZADO, em lib.rs), para o
        Dito subir na bandeja em vez de abrir a janela na cara de quem acabou
        de ligar o computador. O atributo é do uap10 (Windows 10 2004 em
        diante); num Windows mais velho ele é ignorado junto com o namespace, e
        o pior que acontece é a janela aparecer.

        Cuidado ao editar este comentário: dois hifens seguidos dentro de um
        comentário XML são proibidos, e o makeappx recusa o pacote inteiro por
        causa disso (foi o que aconteceu no build 96).
      -->
      <Extensions>
        <uap5:Extension
          Category="windows.startupTask"
          Executable="Dito.exe"
          EntryPoint="Windows.FullTrustApplication"
          uap10:Parameters="--minimizado">
          <uap5:StartupTask
            TaskId="DitoInicioComWindows"
            Enabled="false"
            DisplayName="Dito." />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
