{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPCACHE/*"
        }
      ]
    }
  ]
}
