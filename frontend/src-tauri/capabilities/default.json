{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões das janelas do Dito. A página vem do site publicado (e não da cópia dentro do instalador), para que todo deploy chegue ao app sem reinstalar — daí o `remote`: sem ele o Tauri recusa qualquer comando vindo de fora do app.",
  "windows": [
    "main",
    "mini",
    "aviso"
  ],
  "remote": {
    "urls": [
      "https://dito.albiecloud.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-set-recording-paused",
    "allow-set-meeting-detection",
    "allow-meeting-detection-available",
    "allow-set-background-mode",
    "allow-start-with-windows-state",
    "allow-set-start-with-windows",
    "core:window:allow-set-theme",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-is-minimized",
    "core:window:allow-unminimize",
    "core:window:allow-minimize",
    "core:window:allow-is-visible",
    "core:window:allow-set-size",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPCACHE/*"
        }
      ]
    }
  ]
}
